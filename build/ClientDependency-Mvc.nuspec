<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>ClientDependency-Mvc</id>
    <title>Client Dependency Framework for MVC</title>
    <version>0.0.0.0</version>
    <authors>Shannon Deminick</authors>
    <description>An extension for the ClientDependency framework to support ASP.NET MVC.</description>
    <summary>ClientDependency for MVC</summary>
    <language>en-US</language>
    <licenseUrl>http://www.opensource.org/licenses/ms-pl</licenseUrl>
    <projectUrl>https://github.com/Shandem/ClientDependency</projectUrl>
    <tags>mvc css html javascript clientdependency cdf minify compress combine</tags>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <copyright>Copyright © Shannon Deminick $copyrightyear$</copyright>
    <repository type="git" url="https://github.com/Shandem/ClientDependency" />
    <dependencies>

      <dependency id="Microsoft.AspNet.Mvc" version="4.0.20710" />
      <dependency id="ClientDependency" version="1.8" />

    </dependencies>
  </metadata>
  <files>
    <file src="net48\*.dll" target="lib\net48" />
    <file src="net48\*.pdb" target="lib\net48" />

    <file src="nuget-transforms\web.config.transform" target="Content" />

  </files>
</package>